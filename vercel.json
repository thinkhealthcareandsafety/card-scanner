{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "bom1"
  ],
  "functions": {
    "api/scan.js": {
      "maxDuration": 60,
      "memory": 2048,
      "includeFiles": "{lang,node_modules/tesseract.js,node_modules/tesseract.js-core,node_modules/wasm-feature-detect,node_modules/regenerator-runtime,node_modules/is-url,node_modules/bmp-js,node_modules/zlibjs}/**"
    }
  }
}
